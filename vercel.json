{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "barakahflow-website.vercel.app" }
      ],
      "destination": "https://barakahflowapp.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/delete-account", "destination": "/delete-account.html" }
  ]
}
