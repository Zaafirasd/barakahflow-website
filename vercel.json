{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/zakat-calculator/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "barakahflow-website.vercel.app" }
      ],
      "destination": "https://barakahflowapp.com/:path*",
      "permanent": true
    },
    {
      "source": "/downloads/barakahflow-notification-beta.apk",
      "destination": "/downloads/barakahflow.apk",
      "permanent": false
    },
    {
      "source": "/downloads/barakahflow-notification-beta.apk.sha256",
      "destination": "/downloads/barakahflow.apk.sha256",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/delete-account", "destination": "/delete-account.html" }
  ]
}
